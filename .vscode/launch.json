{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ComicRack Debug (run)",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "build debug",
      "command": "& \"${workspaceFolder}\\ComicRack\\bin\\Debug\\net48\\ComicRack.exe\"",
      "cwd": "${workspaceFolder}\\ComicRack\\bin\\Debug\\net48"
    },
    {
      "name": "ComicRack Release (run)",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "build release",
      "command": "& \"${workspaceFolder}\\ComicRack\\bin\\Release\\net48\\ComicRack.exe\"",
      "cwd": "${workspaceFolder}\\ComicRack\\bin\\Release\\net48"
    },
    {
      "name": "ComicRack Debug (clr debugger)",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "build debug",
      "program": "${workspaceFolder}\\ComicRack\\bin\\Debug\\net48\\ComicRack.exe",
      "cwd": "${workspaceFolder}\\ComicRack\\bin\\Debug\\net48",
      "console": "internalConsole"
    },
    {
      "name": "ComicRack Release (clr debugger)",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "build release",
      "program": "${workspaceFolder}\\ComicRack\\bin\\Release\\net48\\ComicRack.exe",
      "cwd": "${workspaceFolder}\\ComicRack\\bin\\Release\\net48",
      "console": "internalConsole"
    }
  ]
}
